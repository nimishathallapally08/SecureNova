        <mxCell id="RRk26FoSYtyyhybvWdbO-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;No Ingestion checks&lt;/b&gt;&lt;div&gt;&lt;b&gt;L4 x I4 = 16&lt;/b&gt;&lt;/div&gt;&lt;div&gt;(When new docs get added to knowledge base, validation scan for malicious content is not done)&lt;/div&gt;" vertex="1">
