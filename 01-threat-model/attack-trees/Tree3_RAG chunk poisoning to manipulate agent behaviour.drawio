        <mxCell id="RRk26FoSYtyyhybvWdbO-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Chunk Obeyed&lt;/b&gt;&lt;div&gt;&lt;b&gt;L4 x I4 = 16&lt;/b&gt;&lt;/div&gt;&lt;div&gt;(AI treats the text as instruction to followed rather than data to just read and summarize)&lt;/div&gt;" vertex="1">
